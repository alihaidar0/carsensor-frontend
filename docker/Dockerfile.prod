# ============================================================
#  Dockerfile.prod — Production Multi-Stage Build
#
#  Stage 1 (builder): Install deps + build Vite app
#  Stage 2 (runner):  Serve built assets with Nginx
#
#  Final image size: ~25MB
#
#  Build:
#    docker build -f docker/Dockerfile.prod -t my-app:latest .
#
#  Run:
#    docker run -p 80:80 my-app:latest
#    → http://localhost
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM node:24-slim AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy manifests first — Docker caches this layer
# If package.json hasn't changed, pnpm install is skipped
COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

# Copy all source files and build
COPY . .
RUN pnpm build
# Output: /app/dist/

# ── Stage 2: Runner (Nginx) ──────────────────────────────────
FROM nginx:alpine AS runner

LABEL org.opencontainers.image.title="React App"
LABEL org.opencontainers.image.description="Production React application"

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx SPA config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]
